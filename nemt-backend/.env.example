ENV=dev
# Runtime role: NOT a superuser, NOT BYPASSRLS, does not own the tables
DATABASE_URL=postgresql+asyncpg://nemt_app:app_dev_pw@localhost:5432/nemt
# Migration role: owns the tables
DATABASE_OWNER_URL=postgresql+asyncpg://nemt_owner:owner_dev_pw@localhost:5432/nemt
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separated, newest first (supports key rotation)
FIELD_ENCRYPTION_KEYS=
MAIL_BACKEND=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Key for searchable encrypted fields (Medicaid ID). Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# NEVER rotate casually: changing it invalidates every stored blind index.
BLIND_INDEX_KEY=
# none = client must send lat/lng | fake = deterministic fake coordinates (dev only)
GEOCODER_BACKEND=fake
STORAGE_DIR=./var/storage
MAX_UPLOAD_MB=10


---

## Step 3 — `.env.example` additions

Append to `.env.example`:

```bash
# --- billing (Phase 7) ---
# No new runtime config required. Rate plans, rules, and claims are per-company data,
# not deployment settings. The identity fields in the 837P / CMS-1500 exports
# (NPI, tax ID, submitter ID, receiver ID) are currently hardcoded placeholders;
# a per-company billing_settings table is Phase 11 work.


# --- security (Phase 10) ---

# Rate limiting (Phase 10.1)
RATE_LIMIT_LOGIN_IP_PER_MIN=20
RATE_LIMIT_LOGIN_EMAIL_PER_MIN=5
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_FORGOT_PER_HOUR=3
RATE_LIMIT_MFA_IP_PER_MIN=10

# Retention (Phase 10.1)
AUDIT_RETENTION_DAYS=2190          # 6 years
PHI_RETENTION_DAYS=2555            # 7 years

# Key rotation (Phase 10.2 — see docs/key_rotation.md)
# FIELD_ENCRYPTION_KEYS is comma-separated; the FIRST key encrypts, all keys decrypt.
# Rotate quarterly: prepend a new key, wait 30 days, remove the old one.