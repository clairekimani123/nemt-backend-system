ENV=dev
# Runtime role: NOT a superuser, NOT BYPASSRLS, does not own the tables
DATABASE_URL=postgresql+asyncpg://nemt_app:app_dev_pw@localhost:5432/nemt
# Migration role: owns the tables
DATABASE_OWNER_URL=postgresql+asyncpg://nemt_owner:owner_dev_pw@localhost:5432/nemt
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
# JWT_AUDIENCE=mediroutes-api   # tokens without this audience are refused
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separated, newest first (supports key rotation)
FIELD_ENCRYPTION_KEYS=
MAIL_BACKEND=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
# Base of the links in e-mails (password reset -> {FRONTEND_URL}/reset-password?token=...).
# Must be where users actually open the frontend (Vite dev is http://localhost:5173 by default).
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Key for searchable encrypted fields (Medicaid ID). Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# NEVER rotate casually: changing it invalidates every stored blind index.
BLIND_INDEX_KEY=
# none = client must send lat/lng | fake = deterministic fake coordinates (dev only)
GEOCODER_BACKEND=fake
STORAGE_DIR=./var/storage
MAX_UPLOAD_MB=10
MAX_AVATAR_KB=2048
# A driver can't start a trip while the passenger (with a portal login) hasn't accepted them yet.
REQUIRE_PASSENGER_ACCEPTANCE=true
# A driver position older than this is shown to the passenger as possibly out of date.
LOCATION_STALE_SECONDS=120
# Fixes closer together than this are not stored (bounds table growth from chatty devices)
LOCATION_MIN_INTERVAL_SECONDS=5
# Driver positions older than this are deleted nightly (Celery beat: purge-driver-positions)
LOCATION_RETENTION_DAYS=30
# Road distance + ETA for passengers need a self-hosted OSRM (haversine never shows an ETA).
# ROUTING_BACKEND=osrm
# OSRM_URL=http://localhost:5000
