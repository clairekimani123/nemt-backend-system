ENV=dev
# Runtime role: NOT a superuser, NOT BYPASSRLS, does not own the tables
DATABASE_URL=postgresql+asyncpg://nemt_app:app_dev_pw@localhost:5432/nemt
# Migration role: owns the tables
DATABASE_OWNER_URL=postgresql+asyncpg://nemt_owner:owner_dev_pw@localhost:5432/nemt
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separated, newest first (supports key rotation)
FIELD_ENCRYPTION_KEYS=
MAIL_BACKEND=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Key for searchable encrypted fields (Medicaid ID). Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# NEVER rotate casually: changing it invalidates every stored blind index.
BLIND_INDEX_KEY=
# none = client must send lat/lng | fake = deterministic fake coordinates (dev only)
GEOCODER_BACKEND=fake
STORAGE_DIR=./var/storage
MAX_UPLOAD_MB=10


